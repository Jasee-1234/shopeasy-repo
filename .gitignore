# =============================================================================
# .gitignore
# ShopEasy Infrastructure
#
# Git is a version control tool that tracks changes to the 
# code and lets you upload it to GitHub for safekeeping
# and collaboration.
#
# .gitignore tells Git: "ignore these files completely —
# never track them, never upload them, never show them
# in git status."
#
# WHY THIS MATTERS IN THE REAL WORLD:
# In 2022, a developer accidentally committed AWS access keys
# to a public GitHub repo. Within 4 minutes, bots found them
# and spun up $50,000 worth of AWS resources for crypto mining.
# The company got the bill.
# .gitignore is your first line of defence against this.
# =============================================================================

# =============================================================================
# Terraform secrets and Sensitive Files
# These contain your real account IDs, passwords, and keys
# NEVER commit these to any Git repository
# =============================================================================

# Your real variable values
# Contains AWS account ID, Azure tenant ID, email addresses
terraform.tfvars

# Any file ending in .tfvars except the example template
# The example template is safe — it has no real values
*.tfvars
!terraform.tfvars.example

# Terraform state files
# These track what real resources exist in your cloud accounts
# They can contain database passwords, access keys, IP addresses
# in plain text inside the JSON
*.tfstate
*.tfstate.*
*.tfstate.backup

# =============================================================================
# Terraform working Directories
# These are auto-generated by Terraform when you run init
# They are not your code — they are downloaded plugins
# No point tracking them in Git — anyone can regenerate
# them by running terraform init
# =============================================================================

# Downloaded provider plugins (can be hundreds of MB)
.terraform/

# Lock file for provider versions
# Some teams commit this, some do not
# We exclude it here for simplicity
.terraform.lock.hcl

# =============================================================================
# Terraform crash and Override Files
# =============================================================================

# Crash logs generated when Terraform encounters a fatal error
crash.log
crash.*.log

# Override files let individual developers temporarily
# change Terraform behaviour locally without affecting teammates
# They should never be committed
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# =============================================================================
# Used by applications to store API keys, database URLs etc.
# =============================================================================
.env
.env.local
.env.development
.env.staging
.env.production
.env.*

# =============================================================================
# AWS Credential Files
# These should live in ~/.aws/ not in your project folder
# If someone accidentally copies them here, Git ignores them
# =============================================================================
.aws/
credentials
aws-credentials.json

# =============================================================================
# Azure CLI
# If someone accidentally copies them here, Git ignores them
# =============================================================================
.azure/

# =============================================================================
# Google Cloud CLI
# If someone accidentally copies them here, Git ignores them
# =============================================================================
a.config/gcloud/

# =============================================================================
# DOCKER SECRETS
# =============================================================================
.docker/
docker-compose.override.yml
*.tar

# =============================================================================
# OPERATING SYSTEM GENERATED FILES
# Created automatically by Windows, Mac, or Linux
# Completely irrelevant to your infrastructure code
# =============================================================================

# Mac finder metadata
.DS_Store
.AppleDouble
.LSOverride

# Windows thumbnail cache
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Windows Explorer folder settings
[Dd]esktop.ini

# Windows shortcuts
*.lnk

# Windows Recycle Bin
$RECYCLE.BIN/

Icon?

# =============================================================================
# VS Code Editor Files
# Your personal editor preferences should not be
# forced onto your teammates who might use different editors
# =============================================================================
.vscode/
*.code-workspace

# Exception: if your team agrees to share VS Code settings
# you can un-ignore specific files like this:
# !.vscode/settings.json
# !.vscode/extensions.json

# =============================================================================
# Python (used in your microservice app.py files)
# =============================================================================
# Compiled Python files — auto-generated, not your code
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Python virtual environments
venv/
.venv/
env/
ENV/

# Python package distribution folders
dist/
build/
*.egg-info/

# Python testing
.pytest_cache/


# Python test coverage reports
.coverage
htmlcov/

# =============================================================================
# Build Artifacts
# =============================================================================
dist/
build/

# =============================================================================
# IDE
# =============================================================================
.idea/

# =============================================================================
# Node / Javascript (if frontend grows to use npm)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Logs
# Generated at runtime — not source code
# =============================================================================
*.log
logs/
*.log.*

# =============================================================================
# Temporary and Backup Files
# Created by editors and operating systems automatically
# =============================================================================
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~

# =============================================================================
# SSH Keys / Secrets
# If someone accidentally puts their private key in the project
# Git will ignore it rather than uploading it to GitHub
# =============================================================================
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# =============================================================================
# Certificate Files / Secrets
# SSL/TLS certificates contain sensitive cryptographic material
# =============================================================================
*.crt
*.cer
*.p12
*.pfx

# =============================================================================
# Terraform Plan Files
# Generated by terraform plan -out=planfile
# Can contain sensitive resource details
# =============================================================================
*.tfplan
tfplan
